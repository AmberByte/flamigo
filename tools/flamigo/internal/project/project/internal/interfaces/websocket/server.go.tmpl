package websocket

import (
	"net/http"
	"fmt"

	"github.com/gorilla/mux"
	{{if.HasFeature "auth"}}auth "{{.ProjectModulePath}}/internal/domains/auth/domain"{{end}}
	"github.com/amberbyte/flamigo/events"
	"github.com/amberbyte/flamigo/strategies"
)


func Init(auth auth.Service, pubsub events.AppBus, apiRegistry strategies.AppRegistry, apiRouter strategies.AppRouter) error {


	{{if.HasFeature "auth"}}if err := websocketAuthStrategy(auth, apiRegistry, pubsub); err != nil { return err }{{end}}

	addr := ":8080"
	fmt.Printf("Starting websocket server at %s", addr)
	// go hub.run()
	r := mux.NewRouter()
	// r.Methods("OPTIONS").HandlerFunc(
	// 	func(w http.ResponseWriter, r *http.Request) {
	// 		myHttpLib.OptionsForBrowserPreflight(w, r)
	// 	})
	r.HandleFunc("/ws", func(w http.ResponseWriter, r *http.Request) {
		fmt.Println("Received /ws request")
		serveWs(w, r, pubsub, apiRouter)
	})
	err := http.ListenAndServe(addr, r)
	if err != nil {
		fmt.Println("ListenAndServe: ", err)
		panic(err)
	} else {
		fmt.Println("Websocket server started successfully")
	}
	return nil
}
